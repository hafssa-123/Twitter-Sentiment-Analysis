# ============================================
# GROQ — Analyse de sentiment (LLM)
# ============================================
USE_GROQ=true
GROQ_API_KEY=
USE_OPENAI=false

# ============================================
# KAFKA
# ============================================
KAFKA_BROKER=kafka:9092
TOPIC_NAME=tweets
TWEETS_PER_SECOND=0.4

# ============================================
# APIFY — seule source de tweets
# Le mot-clé de recherche est configuré directement dans l'interface Apify
# ============================================
APIFY_TOKEN=
APIFY_ACTOR_1=apidojo/twitter-scraper-lite
APIFY_ACTOR_2=apidojo/tweet-scraper
APIFY_REFRESH_SECONDS=300
